{
  "expo": {
    "name": "Darewaza",
    "slug": "darewaza",
    "scheme": "darewaza",
    "icon": "./assets/brand/icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darewaza.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "ckb",
          "en",
          "ar"
        ]
      }
    },
    "android": {
      "package": "com.trxstudio.darewaza",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#172D57"
      },
      "versionCode": 4,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Darewaza",
      "favicon": "./assets/brand/favicon.png"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "شوێنەکەت بۆ دیاریکردنی شارەکەت بەکاردێت. دەتوانیت بە دەستیش شار هەڵبژێریت.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#172D57",
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withAndroidRelease.cjs"
    ],
    "locales": {
      "ckb": {
        "ios": {
          "CFBundleDisplayName": "Darewaza",
          "NSLocationWhenInUseUsageDescription": "شوێنەکەت تەنها بۆ دۆزینەوەی شارەکەت بەکاردێت. هەڵبژاردنی دەستیش بەردەستە."
        }
      },
      "en": {
        "ios": {
          "CFBundleDisplayName": "Darewaza",
          "NSLocationWhenInUseUsageDescription": "Darewaza uses your location only to identify your city. You can also choose a city manually."
        }
      },
      "ar": {
        "ios": {
          "CFBundleDisplayName": "Darewaza",
          "NSLocationWhenInUseUsageDescription": "يستخدم Darewaza موقعك لتحديد مدينتك فقط. يمكنك اختيار المدينة يدوياً أيضاً."
        }
      }
    }
  }
}
