{
  "name": "darewaza",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "tsx scripts/dev-server.ts",
    "build": "node scripts/build.mjs",
    "build:studio": "vite build --config admin/vite.config.ts",
    "brand:generate": "node scripts/generate-brand.mjs",
    "preview": "vite preview --config admin/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:verify": "node --env-file=.env scripts/verify-database.mjs",
    "api:verify": "tsx scripts/verify-api.ts",
    "bot:setup": "node --env-file=.env scripts/setup-telegram.mjs",
    "export:mobile-web": "expo export --platform web --output-dir mobile-dist",
    "storage:setup": "node --env-file=.env scripts/setup-storage.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "@vercel/functions": "^3.10.5",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.0",
    "expo-linear-gradient": "~58.0.0",
    "expo-location": "~58.0.0",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react": "latest",
    "lucide-react-native": "latest",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "latest",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "swr": "^2.5.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "latest",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^17.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
